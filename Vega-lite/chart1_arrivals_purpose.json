{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "International Arrivals by Purpose of Travel (2015–2025)",
    "fontSize": 16,
    "font": "Georgia",
    "anchor": "start",
    "color": "#1a4a6b",
    "subtitle": "Holiday and visiting friends & relatives drive the majority of arrivals",
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },
  "width": 900,
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/Yukthahasini/FIT2179DV2/main/data/arrivals_trend.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"filter": "datum.year >= 2015 && datum.year <= 2025"},
    {
      "fold": ["holiday", "vfr", "business", "education"],
      "as": ["purpose", "arrivals"]
    },
    {
      "calculate": "datum.purpose === 'holiday' ? 'Holiday' : datum.purpose === 'vfr' ? 'Visiting Friends & Relatives' : datum.purpose === 'business' ? 'Business' : 'Education'",
      "as": "purpose_label"
    },
    {
      "calculate": "datum.arrivals / 1000000",
      "as": "arrivals_millions"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "hover_purpose",
          "select": {
            "type": "point",
            "fields": ["purpose_label"],
            "on": "mouseover"
          }
        }
      ],
      "mark": {
        "type": "line",
        "point": {"size": 60},
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "axis": {"labelFontSize": 12, "titleFontSize": 13}
        },
        "y": {
          "field": "arrivals_millions",
          "type": "quantitative",
          "title": "Arrivals (Millions)",
          "axis": {"labelFontSize": 12, "titleFontSize": 13}
        },
        "color": {
          "field": "purpose_label",
          "type": "nominal",
          "title": "Purpose",
          "scale": {
            "domain": ["Holiday", "Visiting Friends & Relatives", "Business", "Education"],
            "range": ["#1a4a6b", "#e8703a", "#6db3d4", "#4a8a4a"]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 12,
            "labelFontSize": 12
          }
        },
        "opacity": {
          "condition": {"param": "hover_purpose", "value": 1},
          "value": 0.2
        },
        "strokeWidth": {
          "condition": {"param": "hover_purpose", "value": 4},
          "value": 2
        },
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "purpose_label", "type": "nominal", "title": "Purpose"},
          {"field": "arrivals_millions", "type": "quantitative", "title": "Arrivals (M)", "format": ".2f"}
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [4, 3],
        "strokeWidth": 1.5,
        "color": "#aaa"
      },
      "transform": [
        {"filter": "datum.year == 2021 && datum.purpose_label == 'Holiday'"}
      ],
      "encoding": {
        "x": {"field": "year", "type": "ordinal"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -10,
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#999"
      },
      "transform": [
        {"filter": "datum.year == 2021 && datum.purpose_label == 'Holiday'"}
      ],
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"value": 10},
        "text": {"value": "Arrivals at lowest"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
