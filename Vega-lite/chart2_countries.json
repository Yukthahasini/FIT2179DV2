{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 10 Countries Visiting Australia (2025)",
    "fontSize": 16,
    "font": "Georgia",
    "anchor": "start",
    "color": "#1a4a6b",
    "subtitle": "New Zealand leads in arrivals, while China dominates in total spend",
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },
  "width": 700,
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/Yukthahasini/FIT2179DV2/main/data/countries.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"filter": "datum.trips_2025 > 0"},
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "trips_2025", "order": "descending"}]
    },
    {"filter": "datum.rank <= 10"}
  ],
  "mark": {"type": "bar", "cornerRadiusEnd": 4},
  "encoding": {
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": {"field": "trips_2025", "order": "descending"},
      "title": null,
      "axis": {"labelFontSize": 12}
    },
    "x": {
      "field": "trips_2025",
      "type": "quantitative",
      "title": "Arrivals ('000)",
      "axis": {"titleFontSize": 13, "labelFontSize": 12}
    },
    "color": {
      "field": "trips_2025",
      "type": "quantitative",
      "scale": {"scheme": "blues"},
      "legend": null
    },
    "tooltip": [
      {"field": "country", "type": "nominal", "title": "Country"},
      {"field": "trips_2025", "type": "quantitative", "title": "Arrivals", "format": ",.1f"},
      {"field": "spend_2025_m", "type": "quantitative", "title": "Spend in Australia ($M)", "format": ",.0f"},
      {"field": "spend_per_trip_2025", "type": "quantitative", "title": "Spend per Trip ($)", "format": ",.0f"}
    ]
  }
}
