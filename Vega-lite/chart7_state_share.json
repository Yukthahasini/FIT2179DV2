{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "State Rankings by International Arrivals (2015–2025)",
    "fontSize": 16,
    "font": "Georgia",
    "anchor": "start",
    "color": "#1a4a6b",
    "subtitle": "NSW and VIC have held the top two spots throughout the decade",
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },
  "width": 700,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/Yukthahasini/FIT2179DV2/main/data/state_trend.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "toNumber(datum.year)", "as": "year_num"},
    {"calculate": "toNumber(datum.NSW)", "as": "NSW_num"},
    {"calculate": "toNumber(datum.VIC)", "as": "VIC_num"},
    {"calculate": "toNumber(datum.QLD)", "as": "QLD_num"},
    {"calculate": "toNumber(datum.WA)",  "as": "WA_num"},
    {"calculate": "toNumber(datum.SA)",  "as": "SA_num"},
    {"calculate": "toNumber(datum.TAS)", "as": "TAS_num"},
    {"calculate": "toNumber(datum.NT)",  "as": "NT_num"},
    {"calculate": "toNumber(datum.ACT)", "as": "ACT_num"},
    {
      "fold": ["NSW_num","VIC_num","QLD_num","WA_num","SA_num","TAS_num","NT_num","ACT_num"],
      "as": ["state_key", "arrivals"]
    },
    {
      "calculate": "replace(datum.state_key, '_num', '')",
      "as": "state"
    },
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "arrivals", "order": "descending"}],
      "groupby": ["year_num"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year_num",
          "type": "ordinal",
          "title": "Year",
          "axis": {"labelFontSize": 12, "titleFontSize": 13}
        },
        "y": {
          "field": "rank",
          "type": "ordinal",
          "title": "Rank",
          "sort": "ascending",
          "axis": {
            "titleFontSize": 13,
            "labelFontSize": 12,
            "values": [1, 2, 3, 4, 5, 6, 7, 8]
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "title": "State",
          "scale": {
            "domain": ["NSW","VIC","QLD","WA","SA","TAS","ACT","NT"],
            "range": ["#1a4a6b","#e8703a","#6db3d4","#4a8a4a","#c8bfb0","#9b59b6","#e74c3c","#f39c12"]
          },
          "legend": {
            "titleFontSize": 12,
            "labelFontSize": 12,
            "orient": "right"
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "x": {
          "field": "year_num",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "ordinal",
          "sort": "ascending"
        },
        "color": {
          "field": "state",
          "type": "nominal"
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "year_num", "type": "ordinal", "title": "Year"},
          {"field": "rank", "type": "ordinal", "title": "Rank"},
          {"field": "arrivals", "type": "quantitative", "title": "Arrivals", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}
