{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Long Do Visitors Stay? (2025)",
    "fontSize": 16,
    "font": "Georgia",
    "anchor": "middle",
    "color": "#1a4a6b",
    "subtitle": "Most visitors stay between 1 and 2 weeks",
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },
  "width": 420,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/Yukthahasini/FIT2179DV2/main/data/duration.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum.duration_band === 'under_1_week' ? 'Under 1 week' : datum.duration_band === '1_to_2_weeks' ? '1–2 weeks' : datum.duration_band === '2_weeks_to_1_month' ? '2 weeks–1 month' : datum.duration_band === '1_to_2_months' ? '1–2 months' : datum.duration_band === '2_to_3_months' ? '2–3 months' : datum.duration_band === '3_to_6_months' ? '3–6 months' : '6–12 months'",
      "as": "duration_label"
    },
    {
      "calculate": "toNumber(datum.arrivals) / 1000000",
      "as": "arrivals_m"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "hover_bar",
          "select": {
            "type": "point",
            "fields": [
              "duration_label"
            ],
            "on": "click"
          }
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "color": "#6db3d4"
      },
      "encoding": {
        "y": {
          "field": "duration_label",
          "type": "ordinal",
          "sort": [
            "Under 1 week",
            "1–2 weeks",
            "2 weeks–1 month",
            "1–2 months",
            "2–3 months",
            "3–6 months",
            "6–12 months"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "arrivals_m",
          "type": "quantitative",
          "title": "Arrivals (Millions)",
          "axis": {
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "opacity": {
          "condition": {
            "param": "hover_bar",
            "value": 1
          },
          "value": 0.5
        },
        "tooltip": [
          {
            "field": "duration_label",
            "type": "nominal",
            "title": "Duration"
          },
          {
            "field": "arrivals_m",
            "type": "quantitative",
            "title": "Arrivals (M)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "fontWeight": "bold",
        "fontStyle": "italic",
        "color": "#1a4a6b"
      },
      "transform": [
        {
          "filter": "datum.duration_band === '1_to_2_weeks'"
        }
      ],
      "encoding": {
        "y": {
          "field": "duration_label",
          "type": "ordinal",
          "sort": [
            "Under 1 week",
            "1–2 weeks",
            "2 weeks–1 month",
            "1–2 months",
            "2–3 months",
            "3–6 months",
            "6–12 months"
          ]
        },
        "x": {
          "field": "arrivals_m",
          "type": "quantitative"
        },
        "text": {
          "value": "Most common stay time"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
