{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Visitor Spend in Australia by Purpose of Travel (2024–2025)",
    "fontSize": 16,
    "font": "Georgia",
    "anchor": "start",
    "color": "#1a4a6b",
    "subtitle": "Education visitors spend more per trip than any other purpose group",
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },
  "width": 700,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/Yukthahasini/FIT2179DV2/main/data/spend_by_purpose.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "toNumber(datum.spend_m)",
      "as": "spend_num"
    },
    {
      "calculate": "toNumber(datum.year)",
      "as": "year_num"
    },
    {
      "calculate": "datum.purpose === 'Visiting Friends & Relatives' ? 'VFR' : datum.purpose",
      "as": "purpose_short"
    }
  ],
  "mark": {
    "type": "area",
    "opacity": 0.85
  },
  "encoding": {
    "x": {
      "field": "year_num",
      "type": "ordinal",
      "title": "Year",
      "axis": {"labelFontSize": 12, "titleFontSize": 13}
    },
    "y": {
      "field": "spend_num",
      "type": "quantitative",
      "title": "Total Spend ($M)",
      "stack": "zero",
      "axis": {"titleFontSize": 13, "labelFontSize": 12}
    },
    "color": {
      "field": "purpose_short",
      "type": "nominal",
      "title": "Purpose",
      "scale": {
        "domain": ["Holiday", "VFR", "Business", "Education", "Employment", "Other"],
        "range": ["#1a4a6b", "#e8703a", "#6db3d4", "#4a8a4a", "#c8bfb0", "#999999"]
      },
      "legend": {
        "titleFontSize": 12,
        "labelFontSize": 12,
        "orient": "bottom"
      }
    },
    "tooltip": [
      {"field": "year_num", "type": "ordinal", "title": "Year"},
      {"field": "purpose_short", "type": "nominal", "title": "Purpose"},
      {"field": "spend_num", "type": "quantitative", "title": "Spend ($M)", "format": ",.0f"}
    ]
  }
}
