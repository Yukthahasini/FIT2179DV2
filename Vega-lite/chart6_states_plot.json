{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "International Visitor Arrivals by State: 2024 vs 2025",
    "fontSize": 16,
    "font": "Georgia",
    "anchor": "start",
    "color": "#1a4a6b",
    "subtitle": "Every state saw growth in 2025 — NSW remains the top destination",
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },

  "width": 760,
  "height": 360,

  "data": {
    "url": "https://raw.githubusercontent.com/Yukthahasini/FIT2179DV2/main/data/states.csv",
    "format": {"type": "csv"}
  },

  "transform": [
    {"calculate": "toNumber(datum.trips_2024)", "as": "trips_2024_num"},
    {"calculate": "toNumber(datum.trips_2025)", "as": "trips_2025_num"},
    {"calculate": "datum.trips_2025_num - datum.trips_2024_num", "as": "change"}
  ],

  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#d0d0d0",
        "strokeWidth": 4
      },
      "encoding": {
        "y": {
          "field": "state_abbr",
          "type": "nominal",
          "sort": {"field": "trips_2025_num", "order": "descending"},
          "title": null,
          "axis": {
            "labelFontSize": 13,
            "labelFontWeight": "bold"
          }
        },
        "x": {
          "field": "trips_2024_num",
          "type": "quantitative",
          "title": "Arrivals",
          "axis": {
            "values": [0, 1000, 2000, 3000, 4000],
            "labelFontSize": 12,
            "titleFontSize": 13,
            "grid": true
          }
        },
        "x2": {
          "field": "trips_2025_num"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "state_abbr",
          "type": "nominal",
          "sort": {"field": "trips_2025_num", "order": "descending"},
          "title": null
        },
        "x": {
          "field": "trips_2024_num",
          "type": "quantitative"
        },
        "color": {
          "value": "#9ecae1"
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "trips_2024_num", "type": "quantitative", "title": "Arrivals 2024", "format": ",.1f"}
        ]
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "state_abbr",
          "type": "nominal",
          "sort": {"field": "trips_2025_num", "order": "descending"},
          "title": null
        },
        "x": {
          "field": "trips_2025_num",
          "type": "quantitative"
        },
        "color": {
          "value": "#1a4a6b"
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "trips_2025_num", "type": "quantitative", "title": "Arrivals 2025", "format": ",.1f"},
          {"field": "change", "type": "quantitative", "title": "Increase from 2024", "format": ",.1f"}
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11,
        "color": "#444"
      },
      "encoding": {
        "y": {
          "field": "state_abbr",
          "type": "nominal",
          "sort": {"field": "trips_2025_num", "order": "descending"},
          "title": null
        },
        "x": {
          "field": "trips_2025_num",
          "type": "quantitative"
        },
        "text": {
          "field": "trips_2025_num",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}
