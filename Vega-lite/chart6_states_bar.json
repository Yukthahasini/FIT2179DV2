{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "International Visitor Arrivals by State: 2024 vs 2025",
    "fontSize": 16,
    "font": "Georgia",
    "anchor": "start",
    "color": "#1a4a6b",
    "subtitle": "Every state saw growth in 2025 — NSW remains the top destination",
    "subtitleFontSize": 13,
    "subtitleColor": "#666"
  },
  "width": 700,
  "height": 350,
  "data": {
    "url": "https://raw.githubusercontent.com/Yukthahasini/FIT2179DV2/main/data/states.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "toNumber(datum.trips_2024)", "as": "trips_2024_num"},
    {"calculate": "toNumber(datum.trips_2025)", "as": "trips_2025_num"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "color": "#cccccc", "strokeWidth": 2},
      "encoding": {
        "y": {
          "field": "state_abbr",
          "type": "nominal",
          "sort": {"field": "trips_2025_num", "order": "descending"},
          "title": null,
          "axis": {"labelFontSize": 13}
        },
        "x": {"field": "trips_2024_num", "type": "quantitative"},
        "x2": {"field": "trips_2025_num"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 120},
      "encoding": {
        "y": {
          "field": "state_abbr",
          "type": "nominal",
          "sort": {"field": "trips_2025_num", "order": "descending"},
          "title": null,
          "axis": {"labelFontSize": 13}
        },
        "x": {
          "field": "trips_2024_num",
          "type": "quantitative",
          "title": "Arrivals",
          "axis": {
            "values": [0, 1000, 2000, 3000, 4000],
            "titleFontSize": 13, 
            "labelFontSize": 12,
            "grid": true
          }
        },
        "color": {"value": "#6db3d4"},
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "trips_2024_num", "type": "quantitative", "title": "Arrivals 2024", "format": ",.1f"}
        ]
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 120},
      "encoding": {
        "y": {
          "field": "state_abbr",
          "type": "nominal",
          "sort": {"field": "trips_2025_num", "order": "descending"},
          "title": null,
          "axis": {"labelFontSize": 13}
        },
        "x": {
          "field": "trips_2025_num",
          "type": "quantitative",
          "title": "Arrivals",
          "axis": {
            "values": [0, 1000, 2000, 3000, 4000],
            "titleFontSize": 13, 
            "labelFontSize": 12,
            "grid": true
          }
        },
        "color": {"value": "#1a4a6b"},
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "trips_2025_num", "type": "quantitative", "title": "Arrivals 2025", "format": ",.1f"}
        ]
      }
    }
  ],
  "resolve": {"scale": {"y": "shared", "x": "shared"}},
  "config": {"view": {"stroke": null}}
}
